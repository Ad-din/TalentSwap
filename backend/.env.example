# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/skillswap

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MOCK_FALLBACK=true

# Skill Credit Economy (configurable rates)
CREDIT_STARTING_BALANCE=50
CREDIT_RATE_PER_TEACHING_HOUR=10
CREDIT_RATE_PER_LEARNING_HOUR=10
CREDIT_MIN_BALANCE=0

# Matching weights (must sum to 100)
MATCH_WEIGHT_SKILL=40
MATCH_WEIGHT_AVAILABILITY=20
MATCH_WEIGHT_LOCATION=15
MATCH_WEIGHT_EXPERIENCE=15
MATCH_WEIGHT_REPUTATION=10

# Skill compatibility sub-scores (out of 100 before weighting)
SKILL_SCORE_EXACT=100
SKILL_SCORE_RELATED=80
SKILL_SCORE_SUBCATEGORY=60
SKILL_SCORE_CATEGORY=40
SKILL_SCORE_UNRELATED=0

# Location distance thresholds (km -> score out of 100)
LOCATION_SCORE_UNDER_2KM=100
LOCATION_SCORE_UNDER_5KM=80
LOCATION_SCORE_UNDER_10KM=60
LOCATION_SCORE_UNDER_20KM=40
LOCATION_SCORE_OVER_20KM=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
